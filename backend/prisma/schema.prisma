// Forjio service template — minimal Prisma schema.
//
// Ships with only the outbox plumbing required by ADR-0006. Each product
// adds its own domain models on top. Cross-service models (User, Account,
// etc.) live in Huudis and are referenced by ID only — never replicated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Transactional outbox — ADR-0006.
/// Every state change that other services may care about writes a row
/// here inside the same transaction as the change itself. A polling
/// worker reads unpublished rows and fans out to HTTP subscribers.
model OutboxEvent {
  id          String    @id // ULID, globally unique (evt_*)
  type        String // e.g. "suppuo.entity.verb.v1"
  accountId   String? // event scope; null for global events
  aggregateId String? // top-level aggregate id (for indexed queries per entity)
  occurredAt  DateTime
  data        Json
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?

  @@index([publishedAt, createdAt], name: "ix_outbox_unpublished")
  @@index([accountId, type])
  @@index([aggregateId, type])
  @@map("outbox_events")
}

/// Consumer-side idempotency record — ADR-0006.
/// When this service consumes an event, the handler inserts a row here
/// inside its own transaction. Replay attempts hit the PK unique and
/// exit cleanly.
model ProcessedEvent {
  eventId     String   @id
  processedAt DateTime @default(now())

  @@map("processed_events")
}

// ─── Suppuo domain: helpdesk tickets ─────────────────────────────────

/// A support ticket inside a workspace (accountId = the BFF-derived
/// acc_* of the agent workspace that owns the inbox).
model Ticket {
  id             String   @id // tkt_<ulid>
  accountId      String
  /// Per-workspace human-friendly number (#1, #2, …).
  number         Int
  subject        String
  /// open | pending | resolved | closed
  status         String   @default("open")
  /// low | normal | high | urgent
  priority       String   @default("normal")
  /// web | email | whatsapp — how the ticket arrived.
  channel        String   @default("web")
  /// Email OR phone identifies the requester (web/email tickets have
  /// email; WhatsApp tickets have phone — either may be absent).
  requesterEmail String?
  requesterName  String?
  /// E.164 phone for WhatsApp-channel tickets (e.g. +62812…).
  requesterPhone String?
  // ─── Channel wave 2 (telegram identity) ───
  /// Channel-native requester identity for non-phone channels —
  /// the Telegram chat id for channel=telegram tickets.
  requesterExternalId String?
  /// Huudis sub of the assigned agent (workspace member), if any.
  assigneeSub    String?
  /// Free-form labels (normalized: trimmed, lowercased, deduped;
  /// max 10 tags × 40 chars — see lib/ticket-query.ts).
  tags           String[] @default([])
  /// Opaque token for the requester's status link (/t/<token>).
  accessToken    String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastMessageAt  DateTime @default(now())
  // ─── Feature wave: CSAT + automation ───
  /// When the post-resolve CSAT survey email went out (null = never).
  /// The outbox consumer's send-once guard.
  csatSentAt     DateTime?

  messages TicketMessage[]

  @@unique([accountId, number])
  @@index([accountId, status, lastMessageAt])
  @@index([accountId, requesterPhone])
  @@index([accountId, requesterExternalId])
  /// Trigram index keeping ILIKE '%q%' subject search fast (the
  /// migration also does CREATE EXTENSION IF NOT EXISTS pg_trgm).
  @@index([subject(ops: raw("gin_trgm_ops"))], map: "ix_tickets_subject_trgm", type: Gin)
  @@map("tickets")
}

model TicketMessage {
  id         String   @id // tmsg_<ulid>
  ticketId   String
  /// agent | requester
  authorType String
  /// Huudis sub when authorType=agent.
  authorSub  String?
  authorName String?
  body       String
  /// Internal notes are agent-only — never shown on the public
  /// status page and never emailed to the requester.
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ─── Feature wave: attachments ───────────────────────────────────────

/// A file attached to a ticket message. v1 stores the bytes inline in
/// Postgres — SME volume is small (8MB/file, 5 files/message cap) and
/// this avoids new infra. Rows are staged with `messageId = null` at
/// upload time and bound to a message in the message-create
/// transaction; unbound rows older than 1h are swept by the outbox
/// worker tick.
/// // TODO: DO Spaces when volume demands
model Attachment {
  id          String   @id // att_<ulid>
  accountId   String
  /// Null while staged (uploaded but not yet bound to a message).
  messageId   String?
  filename    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  message TicketMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([accountId])
  @@map("attachments")
}

/// Saved reply snippets, per workspace.
model CannedReply {
  id        String   @id // cnr_<ulid>
  accountId String
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("canned_replies")
}

// ─── Feature wave: CSAT + automation ───

/// Post-resolve satisfaction rating — one per ticket (re-rating
/// upserts). score: 1 = 😞, 2 = 😐, 3 = 😊.
model CsatResponse {
  id        String   @id // csat_<ulid>
  accountId String
  ticketId  String   @unique
  score     Int // 1..3 — validated at the API edge
  comment   String?
  createdAt DateTime @default(now())

  @@index([accountId, createdAt])
  @@map("csat_responses")
}

/// Per-workspace automation settings (one row per accountId; absence =
/// everything off). businessHours shape:
///   { tz: 'Asia/Jakarta', days: [{dow:0-6, open:'09:00', close:'17:00'} | null × 7] }
/// days is indexed by dow (0 = Sunday); null = closed that day.
model AccountSettings {
  accountId           String   @id
  businessHours       Json?
  autoResponseEnabled Boolean  @default(false)
  /// Auto-ack template sent when a ticket arrives INSIDE business hours.
  autoResponseInside  String?
  /// Auto-ack template sent OUTSIDE business hours (or on closed days).
  autoResponseOutside String?
  /// Hide "Powered by Suppuo" in requester emails, the chat widget,
  /// and the public form/status pages (a paid-tier perk; unenforced
  /// during early access like everything else).
  hideBranding        Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("account_settings")
}


// ─── Channels (BYO provider integrations — ripllo pattern) ──────────

/// Per-workspace channel/provider connection. Credentials are
/// AES-256-GCM-encrypted JSON (lib/channel-crypto.ts); `config` is
/// public-safe (from-address, WA number, display bits).
model ChannelIntegration {
  id          String   @id // chn_<ulid>
  accountId   String
  /// whatsapp_twilio | email_resend (more coming: whatsapp_cloud,
  /// telegram_bot, livechat)
  provider    String
  /// Provider-side stable id — the WA number, the Resend domain id.
  externalId  String?
  displayName String
  /// pending | active | error
  status      String   @default("pending")
  credentials String   @default("") // encrypted JSON blob
  config      Json     @default("{}")
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([accountId, provider, externalId])
  @@index([accountId, status])
  @@index([provider, externalId])
  @@map("channel_integrations")
}

// ─── Billing ─────────────────────────────────────────────────────────

/// Plugipay-backed plan subscription — one row per workspace
/// (accountId). Absence of a row = the gratis default. Early access:
/// the tier is recorded truthfully but nothing is enforced yet — every
/// workspace gets Toko-level features free until launch.
model BillingSubscription {
  id                        String    @id // bsub_<ulid>
  accountId                 String    @unique
  /// gratis | warung | toko | bisnis
  tier                      String    @default("gratis")
  /// active | past_due | canceled
  status                    String    @default("active")
  /// Last Plugipay checkout session that (re)activated this
  /// subscription — the webhook's idempotency guard keys on it.
  plugipayCheckoutSessionId String?
  currentPeriodEnd          DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([plugipayCheckoutSessionId])
  @@map("billing_subscriptions")
}

// ─── API keys + webhooks ─────────────────────────────────────────────

/// Programmatic access key for the Suppuo API. Format
/// `sk_live_<48hex>` — the plaintext is returned ONCE on creation;
/// only the sha256 hash is stored. `requireAuth` resolves Bearer
/// `sk_live_…` tokens against `keyHash`.
model ApiKey {
  id         String    @id // ak_<ulid>
  accountId  String
  name       String
  /// Display-safe prefix shown in the portal (e.g. "sk_live_3fa9").
  keyPrefix  String
  /// sha256 hex digest of the full plaintext key.
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
  @@map("api_keys")
}

/// A customer endpoint subscribed to suppuo.ticket.* events. The
/// signing secret (`whsec_<hex>`) is shown ONCE at creation; deliveries
/// carry `Suppuo-Signature: t=<unix>,v1=<hmac-sha256>`.
model WebhookSubscription {
  id        String   @id // whs_<ulid>
  accountId String
  url       String
  secret    String
  /// Event-type allowlist as a JSON string array; ["*"] = everything.
  events    Json     @default("[\"*\"]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, active])
  @@map("webhook_subscriptions")
}
